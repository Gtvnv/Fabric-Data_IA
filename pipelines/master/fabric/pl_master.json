        "typeProperties": {
          "method": "POST",
          "relativeUrl": "",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "value": "@json(concat('{\"etapa\":\"ingestao\",\"run_id\":\"', pipeline().RunId, '\",\"text\":\"Pipeline mestre falhou na etapa ''ingestao'' [execução ', pipeline().RunId, ']\"}'))",
            "type": "Expression"
          }
        },
        "externalReferences": {
          "connection": "${CONN_ALERT_WEBHOOK}"
        }
