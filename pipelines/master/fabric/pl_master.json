{
  "properties": {
    "concurrency": 1,
    "parameters": {
      "original_run_id": {
        "type": "string",
        "defaultValue": ""
      },
      "kv_secret_sql": {
        "type": "string",
        "defaultValue": "${KEY_VAULT_SECRET_SQL_PASSWORD_NAME}"
      },
      "kv_secret_storage": {
        "type": "string",
        "defaultValue": "${KEY_VAULT_SECRET_STORAGE_KEY_NAME}"
      },
      "kv_uri": {
        "type": "string",
        "defaultValue": "${KEY_VAULT_URI}"
      },
      "source_container": {
        "type": "string",
        "defaultValue": "${OBJECT_STORAGE_CONTAINER}"
      }
    },
    "activities": [
      {
        "name": "VerificarExecucaoAtiva",
        "type": "Script",
        "policy": {
          "retry": 2,
          "retryIntervalInSeconds": 10,
          "timeout": "0.00:01:00"
        },
        "dependsOn": [],
        "typeProperties": {
          "scripts": [
            {
              "type": "Query",
              "text": {
                "value": "SELECT COUNT(*) AS ativas FROM audit.execucoes WHERE status = N'em andamento' AND run_id <> '@{pipeline().RunId}'",
                "type": "Expression"
              }
            }
          ]
        },
        "externalReferences": {
          "connection": "${CONN_WAREHOUSE_AUDIT}"
        }
      },
      {
        "name": "ValidarConcorrencia",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "VerificarExecucaoAtiva",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@greater(int(activity('VerificarExecucaoAtiva').output.resultSets[0].rows[0].ativas),0)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "FalharExecucaoAtiva",
              "type": "Fail",
              "typeProperties": {
                "message": "Já existe uma execução do pipeline mestre em andamento; nova execução não iniciada",
                "errorCode": "EXECUCAO_EM_ANDAMENTO"
              }
            }
          ]
        }
      },
      {
        "name": "RegistrarInicioExecucao",
        "type": "Script",
        "policy": {
          "retry": 2,
          "retryIntervalInSeconds": 10,
          "timeout": "0.00:01:00"
        },
        "dependsOn": [
          {
            "activity": "ValidarConcorrencia",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "scripts": [
            {
              "type": "NonQuery",
              "text": {
                "value": "INSERT INTO audit.execucoes (run_id, run_original_id, inicio, fim, status) VALUES ('@{pipeline().RunId}', NULLIF('@{pipeline().parameters.original_run_id}',''), SYSUTCDATETIME(), NULL, N'em andamento')",
                "type": "Expression"
              }
            }
          ]
        },
        "externalReferences": {
          "connection": "${CONN_WAREHOUSE_AUDIT}"
        }
      },
      {
        "name": "ingestao",
        "type": "InvokePipeline",
        "dependsOn": [
          {
            "activity": "RegistrarInicioExecucao",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "pipelineId": "${PIPELINE_INGESTAO_ID}",
          "workspaceId": "${FABRIC_WORKSPACE_ID}",
          "waitOnCompletion": true,
          "parameters": {
            "kv_secret_sql": {
              "value": "@pipeline().parameters.kv_secret_sql",
              "type": "Expression"
            },
            "kv_secret_storage": {
              "value": "@pipeline().parameters.kv_secret_storage",
              "type": "Expression"
            },
            "kv_uri": {
              "value": "@pipeline().parameters.kv_uri",
              "type": "Expression"
            },
            "source_container": {
              "value": "@pipeline().parameters.source_container",
              "type": "Expression"
            },
            "run_id": {
              "value": "@pipeline().RunId",
              "type": "Expression"
            }
          }
        },
        "externalReferences": {
          "connection": "${CONN_INVOKE_PIPELINE}"
        }
      },
      {
        "name": "RegistrarSucesso_ingestao",
        "type": "Script",
        "policy": {
          "retry": 2,
          "retryIntervalInSeconds": 10,
          "timeout": "0.00:01:00"
        },
        "dependsOn": [
          {
            "activity": "ingestao",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "scripts": [
            {
              "type": "NonQuery",
              "text": {
                "value": "INSERT INTO audit.execucoes_etapas (run_id, etapa, inicio, fim, status, registros) VALUES ('@{pipeline().RunId}', N'ingestao', '@{formatDateTime(activity('ingestao').ExecutionStartTime,'yyyy-MM-ddTHH:mm:ss.fff')}', '@{formatDateTime(activity('ingestao').ExecutionEndTime,'yyyy-MM-ddTHH:mm:ss.fff')}', N'sucesso', @{int(coalesce(json(coalesce(activity('ingestao').output?.result?.exitValue,'{}'))?['registros'],0))})",
                "type": "Expression"
              }
            }
          ]
        },
        "externalReferences": {
          "connection": "${CONN_WAREHOUSE_AUDIT}"
        }
      },
      {
