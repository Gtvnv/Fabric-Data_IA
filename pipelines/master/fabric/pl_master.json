                "type": "Expression"
              }
            }
          ]
        },
        "externalReferences": {
          "connection": "${CONN_WAREHOUSE_AUDIT}"
        }
      },
      {
        "name": "Notificar_ingestao",
        "type": "WebActivity",
        "policy": {
          "retry": 3,
          "retryIntervalInSeconds": 60,
          "timeout": "0.00:00:20"
