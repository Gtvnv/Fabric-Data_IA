{
  "name": "pl_ingestao",
  "properties": {
    "parameters": {
      "run_id": {
        "type": "string"
      },
      "paralelismo": {
        "type": "int",
        "defaultValue": 4
      },
      "kv_secret_sql": {
        "type": "string"
      },
      "kv_secret_storage": {
        "type": "string"
      },
      "kv_uri": {
        "type": "string"
      },
      "source_container": {
        "type": "string"
      },
      "fabric_workspace_id": {
        "type": "string"
      },
      "fabric_merge_pipeline_id": {
        "type": "string"
      }
    },
    "variables": {
      "falhas": {
        "type": "Array"
      }
    },
    "activities": [
      {
        "name": "VerificarKeyVaultGlobal",
        "type": "WebActivity",
        "policy": {
          "retry": 0,
          "timeout": "0.00:05:00",
          "secureInput": true,
          "secureOutput": true
        },
        "dependsOn": [],
        "typeProperties": {
          "method": "GET",
          "authentication": {
            "type": "MSI",
            "resource": "https://vault.azure.net"
          },
          "url": "@concat(pipeline().parameters.kv_uri,'/secrets/',pipeline().parameters.kv_secret_sql,'?api-version=7.4')"
        }
      },
      {
        "name": "FalhaKeyVaultGlobal",
        "type": "Fail",
        "dependsOn": [
          {
            "activity": "VerificarKeyVaultGlobal",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "message": "Key Vault indisponível ou segredo ilegível: origem não acessada",
          "errorCode": "KEYVAULT_INDISPONIVEL"
        }
      },
      {
        "name": "LookupEntidades",
        "type": "Lookup",
        "policy": {
          "retry": 0,
          "timeout": "0.00:10:00"
        },
        "dependsOn": [
          {
            "activity": "VerificarKeyVaultGlobal",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "source": {
            "type": "LakehouseTableSource"
          },
          "dataset": {
            "referenceName": "ds_lakehouse_config",
            "type": "DatasetReference",
            "parameters": {
              "tabela": "ingestao_entidades"
            }
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "ParaCadaEntidade",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "LookupEntidades",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@take(filter(activity('LookupEntidades').output.value,item().ativo),500)",
            "type": "Expression"
          },
          "isSequential": false,
          "batchCount": 4,
          "activities": [
            {
              "name": "ProcessarEntidade",
              "type": "ExecutePipeline",
              "dependsOn": [],
              "typeProperties": {
                "pipeline": {
                  "referenceName": "pl_ingestao_entidade",
                  "type": "PipelineReference"
                },
                "waitOnCompletion": true,
                "parameters": {
                  "run_id": {
                    "value": "@pipeline().parameters.run_id",
                    "type": "Expression"
                  },
                  "kv_secret_sql": {
                    "value": "@pipeline().parameters.kv_secret_sql",
                    "type": "Expression"
                  },
                  "kv_secret_storage": {
                    "value": "@pipeline().parameters.kv_secret_storage",
                    "type": "Expression"
                  },
                  "kv_uri": {
                    "value": "@pipeline().parameters.kv_uri",
                    "type": "Expression"
                  },
                  "source_container": {
                    "value": "@pipeline().parameters.source_container",
                    "type": "Expression"
                  },
                  "fabric_workspace_id": {
                    "value": "@pipeline().parameters.fabric_workspace_id",
                    "type": "Expression"
                  },
                  "fabric_merge_pipeline_id": {
                    "value": "@pipeline().parameters.fabric_merge_pipeline_id",
                    "type": "Expression"
                  },
                  "entidade": {
                    "value": "@item().entidade",
                    "type": "Expression"
                  },
                  "destino": {
                    "value": "@item().destino",
                    "type": "Expression"
                  },
                  "chave": {
                    "value": "@item().chave",
                    "type": "Expression"
                  },
                  "coluna_watermark": {
                    "value": "@item().coluna_watermark",
                    "type": "Expression"
                  },
                  "origem_tipo": {
                    "value": "@item().origem_tipo",
                    "type": "Expression"
                  },
                  "consulta": {
                    "value": "@item().consulta",
                    "type": "Expression"
                  }
                }
              }
            },
            {
              "name": "RegistrarFalhaEntidade",
              "type": "AppendVariable",
              "dependsOn": [
                {
                  "activity": "ProcessarEntidade",
                  "dependencyConditions": [
                    "Failed"
                  ]
                }
              ],
              "typeProperties": {
                "variableName": "falhas",
                "value": {
                  "value": "@concat(item().entidade,': ',coalesce(activity('ProcessarEntidade').error.message,'erro'))",
                  "type": "Expression"
                }
              }
            }
          ]
        }
      },
      {
        "name": "StatusFinal",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "ParaCadaEntidade",
            "dependencyConditions": [
              "Completed"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@greater(length(variables('falhas')),0)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "FalharExecucao",
              "type": "Fail",
              "typeProperties": {
                "message": {
                  "value": "@concat('Entidades com falha: ',join(variables('falhas'),' | '))",
                  "type": "Expression"
                },
                "errorCode": "ENTIDADES_COM_FALHA"
              }
            }
          ]
        }
      }
    ]
  }
}
