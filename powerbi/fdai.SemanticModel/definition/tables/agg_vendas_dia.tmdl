table agg_vendas_dia
	lineageTag: cf1e9bec-56bb-5825-bef9-ebc8901ba106

	column sk_data
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: sk_data

	column sk_produto
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: sk_produto

	column sk_loja
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: sk_loja

	column quantidade
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: quantidade

	column valor_venda
		dataType: decimal
		summarizeBy: none
		sourceColumn: valor_venda

	column custo_total
		dataType: decimal
		summarizeBy: none
		sourceColumn: custo_total

	measure 'Receita Agg' = SUM(agg_vendas_dia[valor_venda])
		formatString: "R$ #,0.00"

	measure 'Quantidade Agg' = SUM(agg_vendas_dia[quantidade])
		formatString: #,0

	measure 'Margem Agg' = [Receita Agg] - SUM(agg_vendas_dia[custo_total])
		formatString: "R$ #,0.00"

	measure 'Receita Agg LY' = CALCULATE([Receita Agg], SAMEPERIODLASTYEAR(dim_calendario[data]))
		formatString: "R$ #,0.00"

	measure 'Variacao YoY Agg' = DIVIDE([Receita Agg] - [Receita Agg LY], [Receita Agg LY])
		formatString: 0.00%

	partition agg_vendas_dia = entity
		mode: directLake
		source
			entityName: agg_vendas_dia
			schemaName: dbo
			expressionSource: DatabaseQuery
