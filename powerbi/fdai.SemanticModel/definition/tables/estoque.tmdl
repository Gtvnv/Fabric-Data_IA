table estoque
	lineageTag: f2cf30ce-373d-5c16-8498-adf7608d3a7b

	column sk_data
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: sk_data

	column sk_produto
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: sk_produto

	column sk_loja
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: sk_loja

	column quantidade_estoque
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: quantidade_estoque

	measure 'Estoque Total' = SUM(estoque[quantidade_estoque])
		formatString: #,0

	measure 'Itens Sem Estoque' = COUNTROWS(FILTER(estoque, estoque[quantidade_estoque] <= 0))
		formatString: #,0

	partition estoque = entity
		mode: directLake
		source
			entityName: fato_estoque
			schemaName: dbo
			expressionSource: DatabaseQuery
