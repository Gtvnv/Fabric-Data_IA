table previsao_churn
	lineageTag: 71555b99-eabc-5ea6-aec8-b670f0b6cf86

	column sk_cliente
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: sk_cliente

	column data_ref
		dataType: dateTime
		formatString: dd/mm/yyyy
		sourceColumn: data_ref

	column prob_churn
		dataType: double
		summarizeBy: none
		sourceColumn: prob_churn

	column modelo
		dataType: string
		sourceColumn: modelo

	column versao_modelo
		dataType: string
		sourceColumn: versao_modelo

	column pontuado_em_utc
		dataType: dateTime
		formatString: dd/mm/yyyy hh:mm:ss
		sourceColumn: pontuado_em_utc

	measure 'Prob Churn Media' = AVERAGE(previsao_churn[prob_churn])
		formatString: 0.00%

	measure 'Clientes Alto Risco' = COUNTROWS(FILTER(previsao_churn, previsao_churn[prob_churn] >= 0.5))
		formatString: #,0

	partition previsao_churn = entity
		mode: directLake
		source
			entityName: previsao_churn
			schemaName: dbo
			expressionSource: DatabaseQuery
