# Exemplo de variáveis de ambiente. Copie para `.env` (ignorado pelo Git) e preencha.
# Nunca coloque valores reais neste arquivo; segredos ficam no Key Vault.

# Workspace / Fabric
FABRIC_WORKSPACE_ID=<preencher>
FABRIC_WORKSPACE_NAME=<preencher>
FABRIC_TENANT_ID=<preencher>
FABRIC_CLIENT_ID=<preencher>
FABRIC_ENV=<preencher>
FABRIC_TOKEN=<preencher>

# Key Vault (os segredos em si são lidos do Key Vault, nunca deste arquivo)
KEY_VAULT_URI=<preencher>
KEY_VAULT_SECRET_SQL_PASSWORD_NAME=<preencher>
KEY_VAULT_SECRET_STORAGE_KEY_NAME=<preencher>

# Azure SQL
AZURE_SQL_SERVER=<preencher>
AZURE_SQL_DATABASE=<preencher>
AZURE_SQL_USER=<preencher>

# Armazenamento de objetos
OBJECT_STORAGE_ACCOUNT=<preencher>
OBJECT_STORAGE_CONTAINER=<preencher>
OBJECT_STORAGE_PREFIX=<preencher>

# Purview
PURVIEW_ACCOUNT_NAME=<preencher>
PURVIEW_ENDPOINT=<preencher>

# Alertas (Teams / e-mail)
TEAMS_WEBHOOK_SECRET_NAME=<preencher>
ALERT_EMAIL_FROM=<preencher>
ALERT_EMAIL_TO=<preencher>
ALERT_SMTP_HOST=<preencher>

# Testes
HYPOTHESIS_PROFILE=
